# Normalize line endings to LF in both the repo and the working tree.
# core.autocrlf=true on Windows caused phantom "modified" files in git
# status and CRLF breakage in shell scripts run through Git Bash (local
# and CI windows runners report "$'\r': command not found"); forcing LF
# removes the whole class of problems.
* text=auto eol=lf

# Explicit declarations for the main text types
*.go     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
*.nsi    text eol=lf
*.ps1    text eol=lf
Makefile text eol=lf

# Binaries / build artifacts: never convert
*.exe  binary
*.zip  binary

# Trellis: append-only developer journals should merge cleanly across
# parallel sessions/worktrees — each session only appends a new block, so
# there is nothing to actually conflict on.
#
# Do NOT add a rule for workspace/*/index.md here — it is fully regenerated
# every session, so a real conflict there is expected and safe to resolve by
# picking either side (task state lives in task.json, not index.md). See
# .trellis/spec/cli/backend/directory-structure.md for details.
.trellis/workspace/*/journal-*.md merge=union

# Language stats. .trellis/ is the agent plugin workspace — Python tooling,
# task archives and specs that ship with the repo but are not part of the
# MCP server. Left in the stats its ~400 KB of Python outweighs the Go
# source and the repo gets labelled "Python" on GitHub, which hides it from
# language:go searches and misstates what the project is.
.trellis/** linguist-vendored
